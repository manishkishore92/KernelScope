#!/usr/bin/env bash
set -euo pipefail

# Generated by KernelScope.
# Review paths before running on a real kernel tree.

KERNEL_DIR="{{ root }}"
DEVICE="{{ config.device }}"
ARCH="{{ config.arch }}"
SUBARCH="{{ config.subarch }}"
DEFCONFIG="{{ config.defconfig }}"
JOBS="{{ config.jobs }}"
CLANG_PATH="{{ config.clang_path }}"
GCC_PREFIX="{{ config.gcc_prefix }}"
OUT_DIR="$KERNEL_DIR/out/$DEVICE"

cd "$KERNEL_DIR"
mkdir -p "$OUT_DIR"

if [ -n "$CLANG_PATH" ]; then
  export PATH="$CLANG_PATH:$PATH"
fi

export ARCH="$ARCH"
export SUBARCH="$SUBARCH"

if [ -n "$DEFCONFIG" ]; then
  make O="$OUT_DIR" "$DEFCONFIG"
else
  echo "No defconfig set. Edit this script or kernelscope.yml first."
  exit 1
fi

if command -v clang >/dev/null 2>&1; then
  make -j"$JOBS" O="$OUT_DIR" LLVM=1 LLVM_IAS=1 2>&1 | tee "$OUT_DIR/kernel-build.log"
else
  make -j"$JOBS" O="$OUT_DIR" CROSS_COMPILE="$GCC_PREFIX" 2>&1 | tee "$OUT_DIR/kernel-build.log"
fi

echo "Build output: $OUT_DIR"

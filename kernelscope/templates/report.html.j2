<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>KernelScope Report</title>
  <style>
    :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #080b12; color: #eef2ff; }
    body { margin: 0; padding: 32px; background: radial-gradient(circle at top left, #1f3b73 0, transparent 30%), #080b12; }
    main { max-width: 1100px; margin: 0 auto; }
    .hero, .card { border: 1px solid #24324d; background: rgba(12, 18, 31, .82); border-radius: 24px; padding: 24px; box-shadow: 0 20px 80px rgba(0,0,0,.3); }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin: 18px 0; }
    .metric { border: 1px solid #273858; border-radius: 18px; padding: 18px; background: #0d1526; }
    .metric strong { display: block; color: #93c5fd; font-size: 13px; text-transform: uppercase; letter-spacing: .08em; }
    .metric span { display: block; margin-top: 8px; font-size: 26px; font-weight: 700; }
    .finding { border-left: 4px solid #60a5fa; padding: 12px 16px; margin: 10px 0; background: #0c1424; border-radius: 10px; }
    .high { border-left-color: #fb7185; }
    .medium { border-left-color: #fbbf24; }
    .low { border-left-color: #34d399; }
    code { color: #bfdbfe; }
    h1 { margin-top: 0; font-size: 42px; }
    h2 { margin-top: 32px; }
  </style>
</head>
<body>
<main>
  <section class="hero">
    <h1>KernelScope Report</h1>
    <p><strong>Kernel tree:</strong> <code>{{ data.root }}</code></p>
    <div class="grid">
      <div class="metric"><strong>Readiness score</strong><span>{{ data.score }}/100</span></div>
      <div class="metric"><strong>Kernel version</strong><span>{{ data.summary.kernel_version }}</span></div>
      <div class="metric"><strong>Defconfigs</strong><span>{{ data.summary.defconfigs }}</span></div>
      <div class="metric"><strong>DTS/DTSI</strong><span>{{ data.summary.dts_files + data.summary.dtsi_files }}</span></div>
    </div>
  </section>

  <section class="card">
    <h2>Findings</h2>
    {% if data.findings %}
      {% for item in data.findings %}
      <div class="finding {{ item.severity }}">
        <strong>{{ item.severity | upper }} / {{ item.category }}</strong><br />
        {{ item.message }}
        {% if item.suggestion %}<p>{{ item.suggestion }}</p>{% endif %}
      </div>
      {% endfor %}
    {% else %}
      <p>No major findings detected.</p>
    {% endif %}
  </section>

  <section class="card">
    <h2>Toolchain</h2>
    <div class="grid">
    {% for tool in data.toolchain.tools %}
      <div class="metric"><strong>{{ tool.tool }}</strong><span>{{ 'OK' if tool.found else 'Missing' }}</span></div>
    {% endfor %}
    </div>
  </section>
</main>
</body>
</html>

# Generated by KernelScope
DEVICE="{{ data.export.device }}"
BRAND="{{ data.export.brand }}"
MAINTAINER="{{ data.export.maintainer }}"
KERNEL_PATH="{{ data.root }}"
KERNEL_VERSION="{{ data.scan.kernel_version }}"
KERNEL_BUILD_SYSTEM="{{ data.build_system.primary }}"
KERNEL_ARCH="{{ data.scan.arches[0] if data.scan.arches else 'arm64' }}"
KERNEL_DECONFIG="{{ data.scan.defconfigs[0] if data.scan.defconfigs else '' }}"
KERNEL_GKI="{{ 'true' if data.gki.gki_detected else 'false' }}"
KERNEL_KMI_SYMBOL_LISTS="{{ 'true' if data.gki.kmi_symbol_lists_detected else 'false' }}"
KERNEL_READINESS_SCORE="{{ data.readiness.score }}"

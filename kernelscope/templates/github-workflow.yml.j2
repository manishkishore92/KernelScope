name: KernelScope Report

on:
  workflow_dispatch:
    inputs:
      kernel_path:
        description: Kernel tree path inside the runner checkout
        required: true
        default: .
  push:
    branches: [ main, master ]

jobs:
  kernelscope:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "{{ python_version }}"

      - name: Install KernelScope
        run: |
          python -m pip install --upgrade pip
          pip install kernelscope

      - name: Generate report
        run: |
          kernelscope intelligence "{% raw %}${{ github.event.inputs.kernel_path || '.' }}{% endraw %}" --output kernel-report

      - name: Upload report
        uses: actions/upload-artifact@v4
        with:
          name: kernel-report
          path: kernel-report
